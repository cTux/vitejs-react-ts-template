{
  "name": "@ctux/vitejs-react-ts-template",
  "version": "3.6.0",
  "homepage": "https://github.com/cTux/vitejs-react-ts-template",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22",
    "pnpm": "^10"
  },
  "scripts": {
    "build": "pnpm build:bundle && pnpm build:storybook",
    "build:bundle": "vite build",
    "build:storybook": "storybook build",
    "build:analyze": "vite-bundle-visualizer",
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "dev:storybook": "storybook dev -p 6006",
    "lint": "tsc --noEmit && eslint .",
    "postinstall": "check-engine",
    "prepare": "playwright install chromium && husky",
    "preview": "vite preview",
    "serve": "vite serve",
    "test": "pnpm run test:vitest && pnpm run test:playwright",
    "test:playwright": "playwright test playwright",
    "test:vitest": "vitest --run",
    "test:vitest:coverage": "vitest --run --coverage",
    "test:vitest:watch": "vitest",
    "update:major": "pnpm exec npm-check-updates -u --packageManager pnpm",
    "update:minor": "pnpm exec npm-check-updates -u --target minor --packageManager pnpm",
    "update:patch": "pnpm exec npm-check-updates -u --target patch --packageManager pnpm"
  },
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^6.5.0",
    "@mui/styled-engine": "npm:@mui/styled-engine-sc@^6.4.9",
    "@mui/styled-engine-sc": "^6.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.1.19",
    "zod": "^3.25.76"
  },
  "resolutions": {
    "@mui/styled-engine": "npm:@mui/styled-engine-sc@^6.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@julr/vite-plugin-validate-env": "^1.3.0",
    "@playwright/test": "^1.54.1",
    "@storybook/addon-actions": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "ctux-check-engine": "^1.13.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^3.2.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^15.11.7",
    "husky": "^9.1.7",
    "node-fetch": "^3.3.2",
    "npm-check-updates": "^17.1.18",
    "playwright": "^1.54.1",
    "prettier": "^3.6.2",
    "storybook": "^8.6.14",
    "typescript": "5.5.4",
    "vite": "^5.4.19",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-chunk-split": "^0.5.0",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "@mui/styled-engine": "npm:@mui/styled-engine-sc@^6.0.1",
      "glob-parent@<5.1.2": ">=5.1.2",
      "async@<2.6.4": ">=2.6.4",
      "trim@<0.0.3": ">=0.0.3",
      "trim-newlines@<3.0.1": ">=3.0.1",
      "ejs@<3.1.7": ">=3.1.7",
      "async@>=2.0.0 <2.6.4": ">=2.6.4",
      "got@<11.8.5": ">=11.8.5",
      "terser@>=5.0.0 <5.14.2": ">=5.14.2",
      "minimatch@<3.0.5": ">=3.0.5",
      "json5@>=2.0.0 <2.2.2": ">=2.2.2",
      "http-cache-semantics@<4.1.1": ">=4.1.1",
